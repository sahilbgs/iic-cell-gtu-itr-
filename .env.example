# GTU-ITR R&D & IIC Portal - Environment Variables
# Copy this file to .env and fill in the values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite is default if DB_USER / DB_PASSWORD are not specified)
# For SQLite, keep below empty, or set DATABASE_URL=sqlite:///your_db.db
DATABASE_URL=

# For MySQL, specify the connection parameters:
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iic_cell_gtu


# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# AI Model (auto-downloaded on first use)
# Set to 'cpu' to force CPU, or 'cuda' for GPU
AI_DEVICE=auto
AI_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
