# GTU-ITR R&D & IIC Portal - Environment Variables
# Copy this file to .env and fill in the values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# Database (leave empty for SQLite default)
DATABASE_URL=

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# AI Model (auto-downloaded on first use)
# Set to 'cpu' to force CPU, or 'cuda' for GPU
AI_DEVICE=auto
AI_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
